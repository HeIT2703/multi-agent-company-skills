{
  "title": "state.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["current_stage", "status", "active_agents", "last_gate_passed", "remediation_loops", "escalated", "updated"],
  "properties": {
    "current_stage": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$|^none$" },
    "status": { "type": "string", "enum": ["not-started", "in-progress", "blocked", "done"] },
    "active_agents": { "type": "array", "items": { "type": "string" } },
    "last_gate_passed": { "type": "string" },
    "remediation_loops": { "type": "integer", "minimum": 0 },
    "escalated": { "type": "boolean" },
    "updated": { "type": "string" }
  }
}
